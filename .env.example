POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=calendar

# These values are for isolated local development only.
# Production must inject database credentials through deployment secrets.
# Backend runtime/deployment configuration must provide DATABASE_URL.
# Example local backend value:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calendar

OPENAI_API_KEY=key-goes-here
OPENAI_MODEL=gpt-4o-mini